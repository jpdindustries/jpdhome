{
  "name": "jpdhome",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:docker": "sh tests/docker-smoke.sh"
  },
  "dependencies": {
    "@fontsource-variable/bitcount-prop-single": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "vite": "8.1.5"
  }
}
